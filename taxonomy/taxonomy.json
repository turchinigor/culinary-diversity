  "confidence_rules": {
    "high": "Explicit cuisine/menu evidence from official menu, official website, or multiple agreeing strong sources.",
    "medium": "Good indirect evidence or one credible third-party source, but not fully explicit.",
    "low": "Weak, ambiguous, stale, conflicting, or inferred evidence. Prefer review."
  },
  "guardrails": [
    "pizza does not automatically imply Italian",
    "sushi does not automatically imply Japanese",
    "ramen does not automatically imply Japanese unless evidence supports Japanese cuisine",
    "burger does not automatically imply American",
    "kebab or shawarma does not automatically imply Turkish",
    "regional or local does not automatically imply Moldovan or Romanian",
    "venue name alone is weak evidence unless extremely explicit and corroborated",
    "do not treat beverage style as cuisine",
    "do not force one cuisine when menu clearly represents several cuisines"
  ],
