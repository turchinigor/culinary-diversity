{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "taxonomy_name": "culinary_capital_restaurant_taxonomy",
  "version": "1.1.0",
  "scope": "Food-serving establishments for cross-city culinary diversity analysis. OSM amenity is not decisive; bars, pubs, and cafes may be included when substantial food is served.",
  "design_principles": [
    "Classify food offer, not OSM amenity alone.",
    "Keep cuisine geography separate from food specialty and establishment concept.",
    "Allow multiple cuisines and multiple specialties.",
    "Never infer country cuisine from a food item unless evidence supports it.",
    "Preserve unknown instead of forcing a category.",
    "Cafe, bar, and pub records may be included when they have a substantial food offer.",
    "Use unmapped_findings when evidence reveals a meaningful cuisine or specialty absent from taxonomy."
  ],
  "inclusion": {
    "include_if": [
      "restaurant or fast_food venue with evidence of prepared savory food",
      "pub, bar, or cafe with substantial savory food menu",
      "venue marketed primarily as a food destination despite OSM amenity mismatch"
    ],
    "exclude_if": [
      "drinks-only bar/pub",
      "coffee-only or tea-only cafe",
      "dessert-only, ice-cream-only, juice-only, or bakery-only venue when study unit is savory meal establishments",
      "record has no evidence of prepared savory meals"
    ],
    "review_if": [
      "cafe/bar/pub with unclear menu",
      "venue serves only snacks",
      "OSM tags conflict with website/menu evidence",
      "venue status appears closed or uncertain"
    ],
    "food_service_scope_values": [
      "full_meal",
      "limited_meal",
      "snacks_only",
      "drinks_only",
      "dessert_only",
      "unknown"
    ],
    "include_recommended_values": [
      "yes",
      "no",
      "review"
    ]
  },
